{
  "name": "rizolang",
  "version": "0.4.0",
  "description": "Rizo Lang: a secure, simple, full-stack web language for the AI era. Compiles to PostgreSQL and TypeScript.",
  "license": "Apache-2.0",
  "homepage": "https://rizobot.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chaitanyaaggarwal9/rizolang.git"
  },
  "bugs": {
    "url": "https://github.com/chaitanyaaggarwal9/rizolang/issues"
  },
  "keywords": [
    "rizo",
    "rizolang",
    "programming-language",
    "compiler",
    "postgresql",
    "typescript",
    "secure-by-default"
  ],
  "type": "module",
  "bin": {
    "rizolang": "build/src/bin.js"
  },
  "files": [
    "build/src",
    "runtime",
    "docs",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "pg": "8.23.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
