// A small blog: people sign up, write posts and comment.

auth User by email roles admin, editor

// The regions this blog serves. People can download and delete their data on /account.
privacy for EU, UK, IN, US-CA, BR

model User {
  email: Email unique private
  password: Password min 12
  name: Text max 100
  bio: Text max 500 optional
}

model Post {
  author: User
  title: Text min 1 max 200
  body: Text
  published: Bool
  views: Number min 0 optional
  image: File image max 5mb optional
}

model Comment {
  post: Post
  author: User
  body: Text min 1 max 2000
  keep 5 years
}

// Anyone can read published posts.
api GET /api/posts -> list Post.public {
  public
  return db.Post.list(published = true, order title, limit 20)
}

api GET /api/posts/:id -> Post.public {
  public
  return db.Post.find(id)
}

// Logged-in users manage their own posts.
api GET /api/my/posts -> list Post.public {
  requires login
  return db.Post.list(author = me)
}

api POST /api/posts -> Post.public {
  requires login
  return db.Post.create(body, author = me)
}

api PATCH /api/posts/:id -> Post.public {
  requires login
  requires owner author
  return db.Post.update(id, body)
}

// Authors delete their own posts; admins can delete any post.
api DELETE /api/posts/:id {
  requires login
  requires owner author or role admin
  return db.Post.delete(id)
}

// Admins and editors see every post, including unpublished ones.
api GET /api/admin/posts -> list Post.public {
  requires login
  requires role admin, editor
  return db.Post.list(order title)
}

// Comments on a post.
api GET /api/posts/:postId/comments -> list Comment.public {
  public
  return db.Comment.list(post = postId, limit 100)
}

api POST /api/comments -> Comment.public {
  requires login
  limit 10 per minute
  return db.Comment.create(body, author = me)
}

api GET /api/users/:id -> User.public {
  public
  return db.User.find(id)
}

// Pages: generated from the endpoints above. No HTML to write, no way to inject any.
page / {
  public
  title "Rizo Blog"
  text "Stories from our writers."
  link "Write a post" /posts/new
  show GET /api/posts
}

page /posts/:id {
  public
  title "Post"
  show GET /api/posts/:id
  link "Edit" /posts/:id/edit
  link "Delete" /posts/:id/delete
  link "Back to all posts" /
}

page /posts/new {
  requires login
  title "Write a post"
  form POST /api/posts
  then go /posts/:id
}

page /posts/:id/edit {
  requires login
  title "Edit post"
  form PATCH /api/posts/:id
  then go /posts/:id
}

page /posts/:id/delete {
  requires login
  title "Delete post"
  text "This deletes the post for good."
  button "Delete post" DELETE /api/posts/:id
  then go /
}

// Admins also get the built-in /admin pages, to search and delete any record.
page /drafts {
  requires login
  requires role admin, editor
  title "All posts"
  text "Every post, including drafts."
  show GET /api/admin/posts
}
